generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model MediaFile {
  id           String   @id @default(uuid())
  uploaderId   String
  objectKey    String   @unique
  fileName     String
  mimeType     String
  sizeBytes    Int?
  status       String   @default("pending")
  variants     Json?
  purpose      String @default("attachment")
  cropX        Int?
  cropY        Int?
  cropSize     Int?
  createdAt    DateTime @default(now())
  confirmedAt  DateTime?
}